{
  "enabled": {
    "type": "bool",
    "default": true,
    "description": "启用 JM PDF 下载命令"
  },
  "allow_group": {
    "type": "bool",
    "default": true,
    "description": "允许在群聊中使用 /jm"
  },
  "group_access_mode": {
    "type": "string",
    "default": "disabled",
    "description": "群聊名单限制模式",
    "options": ["disabled", "whitelist", "blacklist"],
    "labels": ["不启用名单限制", "白名单", "黑名单"],
    "subtitles": ["所有允许群聊均可使用", "仅名单内群聊可使用", "名单内群聊禁止使用"]
  },
  "group_whitelist": {
    "type": "list",
    "default": [],
    "description": "允许使用 /jm 的群号列表",
    "items": {
      "type": "string"
    }
  },
  "group_blacklist": {
    "type": "list",
    "default": [],
    "description": "禁止使用 /jm 的群号列表",
    "items": {
      "type": "string"
    }
  },
  "cookies": {
    "type": "string",
    "default": "",
    "description": "可选：18comic/JMComic Cookie，格式为 k=v; k2=v2"
  },
  "proxy": {
    "type": "string",
    "default": "",
    "description": "可选代理，例如 http://127.0.0.1:7890；留空时沿用系统代理"
  },
  "upload_file_mode": {
    "type": "string",
    "default": "base64",
    "description": "QQ 文件传输方式",
    "options": ["base64", "file_uri", "legacy"],
    "labels": ["Base64 跨容器传输（推荐）", "file:/// URI（需共享路径）", "旧版裸路径（需共享路径）"],
    "subtitles": ["通过 WebSocket 传输，AstrBot 与 NapCat 不需要共享文件目录", "NapCat 必须能访问 AstrBot 生成的文件路径", "兼容旧版 OneBot，NapCat 必须能访问 AstrBot 生成的文件路径"]
  },
  "retry_without_title": {
    "type": "bool",
    "default": true,
    "description": "文件名带标题上传失败时，自动重试为仅包含 JM 编号的文件名"
  },
  "pdf_password_enabled": {
    "type": "bool",
    "default": false,
    "description": "给生成的 PDF 加密，密码为纯数字 JM ID"
  },
  "timeout": {
    "type": "int",
    "default": 20,
    "description": "单次网络请求超时秒数（5-120）"
  },
  "retry_times": {
    "type": "int",
    "default": 3,
    "description": "网络请求重试次数（1-10）"
  },
  "image_threads": {
    "type": "int",
    "default": 16,
    "description": "单章节图片下载并发数（1-32）"
  },
  "photo_threads": {
    "type": "int",
    "default": 4,
    "description": "章节下载并发数（1-16）"
  },
  "max_concurrent": {
    "type": "int",
    "default": 1,
    "description": "同时处理的漫画数量（1-3）"
  },
  "dir_rule": {
    "type": "string",
    "default": "Bd / JM{Aid}-{Atitle}",
    "description": "jmcomic 图片下载目录规则"
  }
}
